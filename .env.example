# App
PORT=3000
APP_NAME="Mesa de Servicio"
APP_ENV=development
TZ=America/Mexico_City

# JWT
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h

# Initial administrator seed
ADMIN_NAME=Administrador de ejemplo
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_AREA_NOMBRE=Seguridad y accesos

# Development-only sample accounts (used only when NODE_ENV=development)
DEV_AGENT_NAME=Agente de prueba
DEV_AGENT_EMAIL=agente@example.com
DEV_AGENT_PASSWORD=AgentePrueba123
DEV_SUPERVISOR_NAME=Supervisor de prueba
DEV_SUPERVISOR_EMAIL=supervisor@example.com
DEV_SUPERVISOR_PASSWORD=Supervisor123

# SLA
SLA_TIMEZONE=America/Mexico_City
SLA_HORA_INICIO=8
SLA_HORA_FIN=17
SLA_UMBRAL_PROXIMO=0.8
SLA_FESTIVOS=

# Mail
MAIL_TRANSPORT=consola
MAIL_TIMEOUT_MS=5000
PORTAL_PUBLICO_URL=https://soporte.example.com
NOTIFICACIONES_MAX_POR_TICKET=20
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev
SMTP_PASS=dev
MAIL_FROM=no-reply@example.com

# IMAP
IMAP_HOST=localhost
IMAP_PORT=1143
IMAP_SECURE=false
IMAP_USER=dev
IMAP_PASS=dev
IMAP_MAILBOX=INBOX
COMUNICACIONES_MAX_POR_REMITENTE_HORA=20
COMUNICACIONES_MAX_TOTAL=2000
IMAP_MAX_BYTES_MENSAJE=5242880
CORREO_DOMINIOS_PERMITIDOS=

# Public ticket lookup portal
PORTAL_MAX_INTENTOS=5
PORTAL_BLOQUEO_MINUTOS=5
PORTAL_MAX_INTENTOS_POR_CASO=30
PORTAL_MAX_CLAVES=50000
PORTAL_ORIGENES_PERMITIDOS=http://localhost:5173
TRUST_PROXY=false
SUPPORT_CORS_ORIGINS=http://localhost:5174
SWAGGER_ENABLED=true
SWAGGER_ALLOWED_IPS=

# Storage
UPLOADS_DIR=./uploads
ANEXOS_MAX_POR_PETICION=5
ANEXOS_MAX_POR_TICKET=50
ANEXOS_MAX_BYTES_POR_TICKET=52428800
ANOTACIONES_MAX_POR_TICKET=200
